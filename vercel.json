{
  "buildCommand": "npm run build && npm run build:client && node scripts/copy-client-build.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/booking",
      "destination": "/booking/index.html"
    },
    {
      "source": "/booking/",
      "destination": "/booking/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/reminders-run",
      "schedule": "30 16 * * *"
    }
  ],
  "functions": {
    "api/reminders-run.js": {
      "maxDuration": 60
    }
  }
}
