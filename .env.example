# Frontend runtime
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vercel serverless runtime
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
APPOINTMENTS_API_SECRET=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
CRON_SECRET=
MESSAGING_CHANNEL=auto

# WhatsApp (required when using WhatsApp OTP/confirmation APIs
# and for automatic reply messages from /api/whatsapp-webhook)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional: comma-separated owner/admin phone numbers.
# Messages from these numbers keep the internal assistant commands enabled.
WHATSAPP_OWNER_PHONES=
# Set to false if every WhatsApp message should use the internal assistant flow.
WHATSAPP_PUBLIC_CUSTOMER_MODE=true
# Set to false if customers should also get general AI answers beyond booking + FAQ.
# Default is true (customer-only booking + FAQ; otherwise escalates to human).
WHATSAPP_CUSTOMER_ONLY_BOOKING=true
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANG=he
WHATSAPP_CONFIRM_TEMPLATE=
WHATSAPP_CONFIRM_LANG=he

# Optional: comma-separated manager phone numbers for SMS approval requests from new customers
MANAGER_APPROVAL_PHONES=

# SMS (Twilio; required only when using MESSAGING_CHANNEL=sms
# or when using MESSAGING_CHANNEL=auto and WhatsApp is not configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OTP behavior
OTP_SECRET=
OTP_TTL_MIN=10
OTP_COOLDOWN_SEC=60
OTP_MAX_10MIN=5

# Optional CLI helper for `npm run supabase:link`
SUPABASE_PROJECT_REF=
