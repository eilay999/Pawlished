# Frontend runtime
VITE_GEMINI_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vercel serverless runtime
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MESSAGING_CHANNEL=auto

# WhatsApp (required only when using MESSAGING_CHANNEL=whatsapp
# or when using MESSAGING_CHANNEL=auto and no SMS provider is configured)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANG=he
WHATSAPP_CONFIRM_TEMPLATE=
WHATSAPP_CONFIRM_LANG=he

# Optional: comma-separated manager phone numbers for SMS approval requests from new customers
MANAGER_APPROVAL_PHONES=

# SMS (Twilio; required only when using MESSAGING_CHANNEL=sms
# or when using MESSAGING_CHANNEL=auto and WhatsApp is not configured)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OTP behavior
OTP_SECRET=
OTP_TTL_MIN=10
OTP_COOLDOWN_SEC=60
OTP_MAX_10MIN=5

# Optional CLI helper for `npm run supabase:link`
SUPABASE_PROJECT_REF=
